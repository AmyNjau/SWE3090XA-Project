# Claude Code local session/settings data
.claude/

# OS / editor cruft
Thumbs.db
.DS_Store
desktop.ini

# Node (backend) — node_modules lives on local disk, never in the repo
node_modules/
.env
*.log

# Flutter (mobile) — generated platform folders and build output
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
# android/ IS tracked: it carries hand-made manifest and Gradle changes the app
# needs (location permissions, cleartext HTTP for the dev API, the url_launcher
# queries entry, kotlin.incremental=false for Google Drive). Only its
# machine-specific and generated parts are ignored.
mobile/android/local.properties
mobile/android/.gradle/
mobile/android/.kotlin/
mobile/android/**/build/
mobile/ios/
mobile/web/
mobile/windows/
mobile/linux/
mobile/macos/
mobile/.idea/
*.iml
.gstack/

# Python bytecode (docs/reports/build.py)
__pycache__/
*.pyc

# Reference material from another group, kept locally only
Nipo_IST4078A_Group4_Report.*

# Private defence notes: contain the demo account password and the presenting
# script. Kept on Drive only, never pushed to a public repo.
presentation/internal-notes.html
presentation/internal-notes-simple.html

# Android Studio caches (the .run/ launch configurations are kept)
.idea/
presentation/PRIVATE-Defence-Cheat-Sheet.pdf

# The submission zip is a build artifact, rebuilt by docs/submission/build.py
Smart-Health-*-Submission.zip
