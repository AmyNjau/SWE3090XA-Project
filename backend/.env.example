# Copy this file to .env and fill in real values.
# The server runs with sensible defaults if these are left unset.

# Server
PORT=3000

# Data layer: "local" (JSON files, default) or "firestore"
DATA_STORE=local

# Google Maps Platform (only needed when PROVIDER_SOURCE=google)
# Provider source: "mock" (sample data, default) or "google"
PROVIDER_SOURCE=mock
MAPS_API_KEY=

# Firebase (only needed when DATA_STORE=firestore)
# Path to a service-account JSON key, or use application default credentials.
GOOGLE_APPLICATION_CREDENTIALS=
# Firebase project. Required for BOTH Firestore (DATA_STORE=firestore) and
# ID-token verification for sign-in. Without it every token is rejected.
FIREBASE_PROJECT_ID=smart-health-swe3090xa

# Require a signed-in user on /api/diagnose and /api/providers.
# A token that IS supplied is verified either way, so a forged token is never
# accepted regardless of this setting. Leave unset for the demo and tests.
AUTH_REQUIRED=false
