# The presentation deck and its generated single-file build must round-trip
# byte-for-byte, so `python build-standalone.py` produces the same output on
# Windows and POSIX and the 2 MB artifact never shows a whole-file phantom diff.
presentation/index.html                     -text
presentation/Smart-Health-Presentation.html -text

# The Gradle wrapper: `gradlew` is a shell script, so it must keep LF endings
# even when checked out on Windows, or it fails on macOS and Linux with
# "bad interpreter". The jar and the .bat are left exactly as they are.
mobile/android/gradlew                      text eol=lf
mobile/android/gradlew.bat                  -text
mobile/android/gradle/wrapper/gradle-wrapper.jar binary
